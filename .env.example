# ========================================================
# TaSTP - Platform Text-to-Speech Self-Hosted
# Konfigurasi Lingkungan Lokal & Docker
# ========================================================

# Host & Port Backend FastAPI
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Engine Default (piper: CPU lokal ONNX, remote: Colab/GPU luar)
DEFAULT_ENGINE=piper
USE_CUDA=false
MAX_THREADS=4

# Remote Engine GPU (Opsional - mis. Google Colab / Kaggle / RunPod)
REMOTE_ENGINE_URL=
REMOTE_ENGINE_API_KEY=

# URL Backend untuk Frontend Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Etika AI & Metadata Watermark
EMBED_AI_LABEL=true
AI_LABEL_TEXT="Dibuat dengan AI - TaSTP Studio"

# Guardrail & Rate Limiting (Proteksi CPU Intel Iris)
MAX_TEXT_LENGTH=5000
RATE_LIMIT_PER_MINUTE=30

# Google AI Studio (Gemini TTS) - isi nilai asli HANYA di backend/.env (jangan di file ini)
GEMINI_API_KEY=
